# Copy to .env and adjust. NEVER commit a real .env.
# Database: SQLite by default (zero setup). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://algotrade:algotrade@localhost:5432/algotrade
DATABASE_URL=sqlite:///./algotrade.db
# JWT signing secret — use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=7
# CORS origins (comma separated) allowed to call this API
CORS_ORIGINS=http://localhost:3000
# Market-data cache seconds
MARKET_CACHE_SECONDS=60
# Optional: enables the optional /assistant/llm route when set. Off by default.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
